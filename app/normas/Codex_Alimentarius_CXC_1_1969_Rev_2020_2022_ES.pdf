;uuid&q;:&q;b2df3cd6-4672-464c-9137-585a7b2f0063&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;尽管近年已取得持续、逐步进展，但全球饥饿和粮食不安全相关局势仍不容乐观，难以实现《2030年可持续发展议程》提出的各项具体目标。估计2025年共有6.45亿人面临饥饿。除了要获得充足的膳食能量外，人们还必须具有经济能力获得安全、多样化、富含营养的食物。然而，全球各地约有27亿人无力负担健康膳食的成本，而且这一危机还在不断加深，特别是在非洲。2026年版《世界粮食安全和营养状况》报告就此项紧迫挑战开展评价，以探究导致健康膳食成本居高不下背后的结构性驱动因素。 本报告表明，高营养食品，特别是动物源性食品、水果和蔬菜价格较高，在健康膳食成本中占比近70%。报告利用现有数据和分析工具，探讨地域差异、农业生产率低下、价值链低效（包括食物损失和浪费）等因素如何对健康膳食的获取构成严重障碍。 为可持续地实现“零饥饿”目标，政策制定者必须采取精准、多部门干预措施，从将农业补贴转向园艺生产，到投资发展完善的冷链和运输网络。本报告为各国政府和利益相关方提供全面的策略，旨在结构性降低膳食成本，维护人力资本，同时避免农业粮食体系的隐性成本。&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;c3e9700a-98e6-4e57-ba3c-8aebf6102e8b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;247 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;281fe269-461d-4d43-8cf8-f8c953feac46&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2663-8479&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;28eecdbd-a215-41e9-af36-f5d4b7b6b582&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-141001-1&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;55ff29ba-e965-4cd5-8352-6da60fc541a6&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2663-8460&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;1af90b79-62ac-46af-970b-efb73cf5d03f&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd8306zh&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;396bef47-89c1-4bee-98f7-8f270a35be95&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Chinese&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;14938e22-aff3-4db8-bdd9-55df19fc5353&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;粮农组织 ; 国际农业发展基金 ; 联合国儿童基金会 ; 世界卫生组织 ; 世界粮食计划署 ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.ispartofseries&q;:[{&q;uuid&q;:&q;e739b7b0-ce81-4619-920a-ab0278b2ceeb&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;世界粮食安全和营养状况&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.number&q;:[{&q;uuid&q;:&q;5e13eb7c-c7a7-4eef-ae38-52d7ee8d6ac8&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;e7b069e1-a7c6-43b8-a709-5c4a8040ea76&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;ce3fdba7-e2ec-474b-991e-382004f49dc7&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CC BY 4.0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;e28c12d1-fb7e-4a33-932e-8fcb3621d59c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026年世界粮食安全和营养状况&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title.englishtranslation&q;:[{&q;uuid&q;:&q;a1179d8f-1e69-42d9-9a78-874ce83f045d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The State of Food Security and Nutrition in the World 2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title.subtitle&q;:[{&q;uuid&q;:&q;3206c186-886b-47c9-85a7-a888a4446121&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;了解和应对健康膳食高成本问题&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title.subtitleenglishtranslation&q;:[{&q;uuid&q;:&q;d9be55cc-accb-407c-88f7-d26088d32f79&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Understanding and addressing the high cost of a healthy diet&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.type&q;:[{&q;uuid&q;:&q;5e27bd4d-77be-45cb-9cb5-dd875891d16d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Book (series)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.altmetricbadge&q;:[{&q;uuid&q;:&q;9534e9aa-7933-4969-9cb4-354df65e3eb5&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Yes&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&