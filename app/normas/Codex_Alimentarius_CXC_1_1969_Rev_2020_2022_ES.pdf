2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;84cba3d0-162f-4a6f-9998-820c39dd1386&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-09-28T07:44:51Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;563967d3-cedc-4b3a-8936-af76c6c00f88&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;This edition of The State of the World’s Forests examines how forest and landscape restoration can be scaled to deliver lasting benefits for people and the planet. Drawing on the latest evidence and experiences from around the world, it explores four key pathways for accelerating restoration: empowering people and strengthening rights; implementing restoration at the landscape scale; mobilizing finance and business models that work for restoration; and creating coherent policies, institutions and legal frameworks.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;5c1fac40-91fc-4cea-be51-88df528a4969&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;300 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;1f9c121e-0b28-45bd-97bc-037fe26e43b5&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2521-7542&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;ae353555-3f8c-4d92-b5a3-c8919f61c42a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140871-1&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;ed219491-2297-4ee6-a176-5b88d2a2f1c1&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;1020-5705&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;9a424c8f-210c-4380-9fd6-241f06786961&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/ce0633en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;