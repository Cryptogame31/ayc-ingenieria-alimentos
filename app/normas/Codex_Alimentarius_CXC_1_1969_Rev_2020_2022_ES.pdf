-f7bdbdd56cbb/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/d536579c-3494-41e5-a327-f7bdbdd56cbb/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/d536579c-3494-41e5-a327-f7bdbdd56cbb&q;}},&q;_name&q;:&q;La Situation mondiale des pêches et de l’aquaculture 2026&q;,&q;id&q;:&q;d536579c-3494-41e5-a327-f7bdbdd56cbb&q;,&q;uuid&q;:&q;d536579c-3494-41e5-a327-f7bdbdd56cbb&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;086d3eaa-2c3c-4d29-bd58-12a10fe00a6a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;1216c178-6030-4b67-afc1-e50815bbc47d&q;,&q;language&q;:null,&q;value&q;:&q;2026-09-03T10:41:36Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;53740877-bddb-43e0-9039-cfde4dafdaf3&q;,&q;language&q;:null,&q;value&q;:&q;2026-09-03T10:41:36Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;ebeada57-8bc5-4504-bd0e-3020ed02bf15&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;11867349-5738-4fea-89f4-0b1c56a4f7bb&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-09-03T10:36:09Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;1583fe09-26ee-4e30-af4e-ebe69708e7c0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;L’édition de 2026 de La Situation mondiale des pêches et de l’aquaculture fournit les informations et les analyses factuelles les plus récentes sur les défis, les opportunités et les solutions qui façonnent le présent et l’avenir du secteur. Le rapport montre comment la FAO traduit la vision de la transformation bleue dans des résultats concrets, par le biais des projets de terrain qu’elle mène en étroite collaboration avec ses membres, ses partenaires et les principales parties prenantes. Il présente les actions réalisées afin de maximiser la contribution des produits alimentaires d’origine aquatique à la sécurité alimentaire mondiale, à la réduction de la pauvreté et au développement économique, ainsi que les efforts déployés pour orienter les politiques, faire progresser la recherche scientifique et l’innovation, et favoriser le renforcement des capacités.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;c5d11e00-4a8b-4dc6-a222-d342015605b7&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;256 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;d67de275-8ddc-46a5-8f3b-09e486b2ba53&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2663-8371&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;e9052a94-5f74-451d-a1bf-a9770235a070&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140838-4&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;79d107d6-e4ba-4dbb-9acb-cd1b3b1ebc5a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;1020-5497&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;f6a456d6-7d8a-4846-8ae3-0e4e86d071a5&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd8357fr&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;d1268f4e-aedb-4c94-a257-4f02a33572aa&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;French&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;91272eb6-8f63-490c-910b-52ff2ec8c4b1&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.ispartofseries&q;:[{&q;uuid&q;:&q;9acead82-7a59-40ed-8dcf-56a6cc6082df&q;,&q;language