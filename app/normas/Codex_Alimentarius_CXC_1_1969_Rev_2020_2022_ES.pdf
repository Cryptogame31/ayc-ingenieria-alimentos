d&q;:&q;cc1da468-6894-400d-be7d-28c70625e177&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;b3c6549a-ab1a-493c-9c61-021151c4752c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;​ФАО;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;3f71e225-b3be-4dd3-a951-e06f400480aa&q;,&q;language&q;:null,&q;value&q;:&q;2026-09-03T10:42:08Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;32636dbd-df60-41af-8645-f6d5cefd9a5d&q;,&q;language&q;:null,&q;value&q;:&q;2026-09-03T10:42:08Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;f7f77421-bf20-4de4-bfaa-b3813f29586e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;76f732c4-a4cc-44bc-aea0-d0c8f82d2da0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-09-03T10:37:01Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;da1f8e65-56c7-4483-95ce-8e9c75c0566b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;В докладе \&q;Состояние мирового рыболовства и аквакультуры  – 2026\&q; приводятся наиболее актуальные фактологически обоснованные сведения и выводы о проблемах, возможностях и решениях, влияющих на настоящее и будущее сектора. В выпуске 2026 года демонстрируется, как ФАО претворяет в жизнь инициативу \&q;Голубая трансформация\&q;, реализуя проекты на местах в тесном сотрудничестве с членами, партнерами и ключевыми заинтересованными сторонами. Особое внимание в нем уделяется усилиям, направленным на повышение вклада систем производства пищевой продукции из водных биоресурсов в обеспечение глобальной продовольственной безопасности, сокращение масштабов нищеты и экономическое развитие, а также на активизацию информационно-просветительской деятельности в области политики, содействие научным исследованиям и инновационной деятельности и дальнейшее укрепление потенциала.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;b77ebaa0-1d2c-4f92-a0b8-22242c2d811e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;237 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;2a38d6eb-39d1-4b49-88d6-9d2c610afe24&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2663-8657&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;c4e3e71a-4758-4b81-957e-bcf9500ca701&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140836-0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;a1a60708-9945-4a2c-828e-26573d193d88&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2070-6197&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;249cd6dd-9e11-4cf1-8961-641142a49281&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd8357ru&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;65cdcd86-e38b-4a9e-bae8-7731736b6469&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Russian&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;de8ac0a4-898e-4477-96ed-9fe137b91124&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;ФАО ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.ispartofseries&q;:[{&q;uuid&q;:&q;b7dac433-cdf6-432e-8fa1-718ef97d4379&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;СОСТОЯНИЕ МИРОВОГО РЫБОЛОВСТВА И АКВАКУЛЬТУРЫ&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.number&q;:[{&q;uuid&q;:&q;dc2f931f-6a46-41b5-9419-223c5bda9528&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;8ae55166-2188-4938-9882-394a6ef0482d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;