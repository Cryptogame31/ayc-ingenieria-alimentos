/core/items/dc526503-d9ef-461b-92e3-fedbe91e2f51/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/dc526503-d9ef-461b-92e3-fedbe91e2f51&q;}},&q;_name&q;:&q;The State of Agricultural Commodity Markets 2026&q;,&q;id&q;:&q;dc526503-d9ef-461b-92e3-fedbe91e2f51&q;,&q;uuid&q;:&q;dc526503-d9ef-461b-92e3-fedbe91e2f51&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;3123d81c-2a21-4075-b9f8-3dc555503647&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;b3df0971-d6f0-41af-bfe6-d2d9be8cce64&q;,&q;language&q;:null,&q;value&q;:&q;2026-10-13T17:35:48Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;ba5c6511-9d3d-4e2a-8df6-1dbe29a5b619&q;,&q;language&q;:null,&q;value&q;:&q;2026-10-13T17:35:48Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;18a33f75-5c7c-4a30-8302-414a8add31e0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;a6744a16-d505-4b6e-a0b1-d8205f4cb0fc&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-10-13T17:33:02Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;5f5eb2eb-395a-4557-a32c-79b9c9ee0ecf&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Food and agricultural trade increased fivefold between 2000 and 2024, with low- and middle-income countries becoming more integrated into global markets. Yet these markets face growing exposure to shocks, including extreme weather, conflicts, pandemics, macroeconomic pressures and financial crises. The 2026 edition of The State of Agricultural Commodity Markets examines how such shocks affect trade, how disruptions are transmitted through trade linkages, and what this means for global food security. It highlights the need for trade policies that reflect the interdependence of agrifood systems, strengthen resilience and help mitigate the effects of shocks on food markets and food security.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;9f3aa0c1-9bb8-4b34-bf50-be474cb2c554&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;103&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;18d98eb5-8628-4070-995e-f13d4688efc4&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2663-8215&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;172892c6-04be-44f4-842a-3d7cc3c48a62&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140464-5&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;c7c5294f-e0ae-4c3e-beb2-6e2e5b800332&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2663-8207&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;6a69420a-b992-43b5-bd3b-925a61c07fef&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd8309en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;5ac9fc7f-6676-4cc7-b849-51c63f5652ad&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;4c1b144f-18df-4f72-82b4-1b36ac68ac64&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.ispartofseries&q;:[{&q;uuid&q;:&q;9f07c463-1e92-408c-ba81-bc3b7819b1c4&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The State of Agricultural Commodity Markets (SOCO)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.number&q;:[{&q;uuid&q;:&q;a214c603-396d-411a-a891-482e7bbc98eb&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null