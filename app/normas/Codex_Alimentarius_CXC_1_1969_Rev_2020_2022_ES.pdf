ore/items/12164fb6-575e-4d8d-8d91-4bae962069a6/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/12164fb6-575e-4d8d-8d91-4bae962069a6/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/12164fb6-575e-4d8d-8d91-4bae962069a6&q;}},&q;_name&q;:&q;Fishery and Aquaculture Statistics – Yearbook 2024&q;,&q;id&q;:&q;12164fb6-575e-4d8d-8d91-4bae962069a6&q;,&q;uuid&q;:&q;12164fb6-575e-4d8d-8d91-4bae962069a6&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;3624dc69-1a93-4540-8afe-e2e1199407c9&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;5cf0f767-c5e9-4cc6-ab1c-569dfc2f10e2&q;,&q;language&q;:null,&q;value&q;:&q;2026-09-07T06:00:20Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;161f5773-ed7a-4d82-820e-e2990b440495&q;,&q;language&q;:null,&q;value&q;:&q;2026-09-07T06:00:20Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;6f689b7d-c4e2-43f6-bce4-e0d80d5fd04c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;fe00e103-1c4d-48eb-a357-23858c63f4d1&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-09-07T05:57:23Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;9b34dad6-0e4d-41da-bb8b-d5b48069b600&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The FAO Yearbook of Fishery and Aquaculture Statistics, prepared by the Statistics and Information Team of the FAO Fisheries and Aquaculture Division, presents a synthesis of the major trends in the fisheries and aquaculture sector. Statistics are presented in eight thematic chapters covering statistics of production (total, aquaculture and capture fisheries), employment, fleet, utilization, consumption and trade, together with a section containing selected tables and annexes, including notes, concepts, classifications and a map of the FAO Major Fishing Areas. The yearbook is intended to serve as a primary tool for policymakers, researchers and analysts, as well as for the general public interested in the past and current developments in the sector.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;3f94d02b-20ea-4ab7-8dd5-31735618abe1&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;236 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;30396fae-89c2-463c-9cc9-0ed50990eae3&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2960-0502&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;7a903fc4-b552-49bb-8b22-47bcdefe513a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140955-8&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;b15b3901-0bb9-4a37-9dab-b4f49fd08212&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2960-0499&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;05d87ec5-7a9a-4842-b0e5-91dfc94155fe&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/ce1217en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;cf91a3a7-7f66-4036-a103-37917b467cb8&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;4ffe4925-9cb6-4975-a2cf-9a3660af46c5&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.ispartofseries&q;:[{&q;uuid&q;:&q;997d0441-a333-4e84-a71b-e318f8c9003b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO Yearbook of Fishery and Aquaculture Statistics&q;,&q;pl