;Guidance on the conduct of national censuses of agriculture has been provided to countries since 1930 through decennial programmes. This publication, World Programme for the Census of Agriculture 2030 (WCA 2030), is intended to provide guidance on agricultural censuses carried out by countries in the period between 2026 and 2035. The census of agriculture continues to play a key role in the collection of structural data on the agriculture sector. The WCA 2030 aims to provide countries with the tools and knowledge necessary to conduct comprehensive and accurate agricultural censuses, ensuring that the data collected is relevant, timely, internationally comparable and actionable.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;d4d52b61-346b-48ae-b5ad-5ceb64b5d0c0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;232 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;048f4924-a244-40d6-8f4c-3a37ff5aea55&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2664-746X&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;4af23630-4e8f-4ab1-8641-fd1deb7e4912&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140661-8&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;37138db1-9e44-4915-a56f-7051c70c8fe0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;1014-3378&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;7a481081-4b9f-4eb3-9566-1d9262dd7a37&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd9437en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;e396a490-0728-461b-8dea-f882618b12d6&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;cfbb88cd-323f-40d3-bfcf-8bd87d454c9b&