rity&q;:null,&q;confidence&q;:-1}],&q;dc.title.englishtranslation&q;:[{&q;uuid&q;:&q;d7ab969e-ae03-4747-89d7-6e5818f65900&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The State of Food Security and Nutrition in the World 2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title.subtitle&q;:[{&q;uuid&q;:&q;8022741f-1c36-4f8e-952f-53d4ede9412f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Comprender y abordar el elevado costo de una dieta saludable&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title.subtitleenglishtranslation&q;:[{&q;uuid&q;:&q;fd561e98-c4a3-4731-99ff-033e7316ec19&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Understanding and addressing the high cost of a healthy diet&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.type&q;:[{&q;uuid&q;:&q;3486263f-673a-481f-933d-b40273099106&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Book (series)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.altmetricbadge&q;:[{&q;uuid&q;:&q;ef7a3310-7237-476f-9b5a-35f224614971&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Yes&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.citation&q;:[{&q;uuid&q;:&q;e81d2c62-a9f1-4bcf-9d08-09dbf0586ddd&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;&l;div class=\&q;ExternalClass8A3613DCF5E34CC19BECE38FDD59F3AC\&q;&g;&l;p&g;&l;span style=\&q;font-size&a;#58;12.8px;\&q;&g;FAO, FIDA, OMS, PMA y UNICEF. 2026. &l;em&g;El estado de la seguridad alimentaria y la nutrición en el mundo 2026&a;#58; Comprender y abordar el elevado costo de una dieta saludable&l;/em&g;. Roma.&l;/span&g;&l;br&g;&l;/p&g;&l;/div&g;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.date.available&q;:[{&q;uuid&q;:&q;c9c4d00b-0d20-443a-b15e-3005e3761ba3&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-10-20T22:00:00Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.embargo&q;:[{&q;uuid&q;:&q;9a78c758-55a7-42a0-93b4-345c855a60a3&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;No&q;,&q;place&q;:0,&