elationships&q;},&q;version&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/f635e477-b37a-46f8-bc10-34d56cec6332/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/f635e477-b37a-46f8-bc10-34d56cec6332/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/f635e477-b37a-46f8-bc10-34d56cec6332/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/f635e477-b37a-46f8-bc10-34d56cec6332/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/f635e477-b37a-46f8-bc10-34d56cec6332&q;}},&q;_name&q;:&q;Extreme heat and agriculture&q;,&q;id&q;:&q;f635e477-b37a-46f8-bc10-34d56cec6332&q;,&q;uuid&q;:&q;f635e477-b37a-46f8-bc10-34d56cec6332&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;e466fece-e469-481a-9196-640eb412fb7c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO; WMO;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;ddd82f39-d6df-4e33-801b-6114f6c0bb78&q;,&q;language&q;:null,&q;value&q;:&q;2026-04-22T07:40:18Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;82f4c6e7-023d-4fd3-bcbf-f894bae3b9df&q;,&q;language&q;:null,&q;value&q;:&q;2026-04-22T07:40:18Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;405a5c2a-442c-4113-8e70-590925ef1e2e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;30cfdbe3-949c-4898-9def-dd8322e0ba7c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-04-22T07:36:05Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;f5005bad-ebae-4548-9f3f-84a494702942&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Extreme heat is emerging as one of the most urgent and least understood threats to agriculture and food security. Rising temperatures, prolonged heatwaves, and shifting climate patterns are already disrupting crop yields, livestock health, water availability, and rural livelihoods – with impacts falling disproportionately on the most vulnerable.Because extreme heat is predictable, strengthening climate services and early warning systems linked to anticipatory actions is a key opportunity. It is also clear that there are profound limits to what adaptation can achieve. With global mean temperatures on the cusp of exceeding the 1.5 °C warming limit outlined in the Paris Agreement, the urgency for adaptation and mitigation action only grows. The only durable solution to protect the future of global agrifood systems from the escalating threat of extreme heat lies in ambitious, multilateral climate change mitigation.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;538bfc21-9f81-4b93-8c19-b0994ffaed81&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;108 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;a6195e8d-ea07-4ff5-b5ba-2c18e2e2cc2a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140656-4&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;0544326b-2f1c-4845-bbab-b61347822a93&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd9394en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;00fd021f-ceb8-42ca-b118-828b26b35ebc&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;e7aeba24-f282-498a-84ae-d85b07e32374&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ; WMO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;6e