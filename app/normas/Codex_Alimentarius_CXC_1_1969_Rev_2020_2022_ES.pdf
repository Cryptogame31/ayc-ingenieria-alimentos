f30c-83e3-4dc8-84c3-abce534adbcd/bundles&q;},&q;mappedCollections&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/68fdf30c-83e3-4dc8-84c3-abce534adbcd/mappedCollections&q;},&q;owningCollection&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/68fdf30c-83e3-4dc8-84c3-abce534adbcd/owningCollection&q;},&q;relationships&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/68fdf30c-83e3-4dc8-84c3-abce534adbcd/relationships&q;},&q;version&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/68fdf30c-83e3-4dc8-84c3-abce534adbcd/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/68fdf30c-83e3-4dc8-84c3-abce534adbcd/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/68fdf30c-83e3-4dc8-84c3-abce534adbcd/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/68fdf30c-83e3-4dc8-84c3-abce534adbcd/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/68fdf30c-83e3-4dc8-84c3-abce534adbcd&q;}},&q;_name&q;:&q;Vanuatu: poultry value chain&q;,&q;id&q;:&q;68fdf30c-83e3-4dc8-84c3-abce534adbcd&q;,&q;uuid&q;:&q;68fdf30c-83e3-4dc8-84c3-abce534adbcd&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;291b9a38-7e67-409b-8df4-43e96f44a16e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;98458334-b5ad-40fc-9977-fcd3a1a55ba0&q;,&q;language&q;:null,&q;value&q;:&q;2026-11-06T15:05:38Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;9ddea26a-4a5e-484a-b602-8345ab81e62a&q;,&q;language&q;:null,&q;value&q;:&q;2026-11-06T15:05:38Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;db276987-458b-462e-ab94-67a82b374f5f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;c81408c6-5d72-464b-ac93-d4f701cb783f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-11-06T15:01:55Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;d615cede-b73e-4353-bc80-435bc5687904&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Vanuatu&s;s poultry sector combines widespread traditional backyard chicken-keeping predominantly led by women and youth. There is emerging semi-commercial layer and broiler industry near Port Vila and Luganville. While domestically produced frozen chicken cannot compete with cheaper imports, higher prices for fresh birds offer a viable, if limited, niche market (estimated 10,000–24,000 birds/month).Key constraints include heavy dependence on costly imported feed and day-old chicks, disrupted air freight since 2024, underutilized local feed ingredients, limited processing and cold-chain infrastructure, and a shortage of specialized veterinary and extension services.The analysis recommends a phased roadmap: piloting decentralized feed-processing units (Port Vila and Santo) under the current FAO Technical Cooperation Programme; community-based breeding to strengthen indigenous stock; extension and training system upgrades; market linkages with hotels and retailers; and establishing a National Poultry Task Force to coordinate policy and investment. With sustained support, Vanuatu could shift from import dependence toward a resilient, locally driven poultry sector by 2035.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;0f56d43d-60ba-4aed-b470-48b2829525ba&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;8 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;a643263e-3d99-490a-b380-d3764065bc2c&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/ce2324en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;2355ab7b-4076-4c3a-bf70-e79584df1b19&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;5d4a58e7-24f1-477b-8833-3ce4249a3941&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;462645d4-9fd6-480a-bd57-4301fa979a0e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;274289f1-f1e2-4328-b070-e4b44d228d04&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CC BY 4.0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;a17bc224-c00a-4fed-88e4-ce26e7fc2e96&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Vanuatu: poultry value chain&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title.subtitle&q;:[{&q;uuid&q;:&q;059c1345-9f8f-48ba-890a-bc7b7ee3c37e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Situation analysis: special agricultural product&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.type&q;:[{&q;uuid&q;:&q;7be4c97d-28e0-4424-9cae-fac3d17b4b54&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Booklet&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.altmetricbadge&q;:[{&q;uuid&q;:&q;53b9ae70-e6b9-453d-b3c5-7325ce786d16&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;No&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.citation&q;:[{&q;uuid&q;:&q;5949ab11-52f6-462e-a900-d548e30ec654&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;&l;div class=\&q;ExternalClass81E83C6126DD46AEB7E2227F9F198635\&q;&g;&l;p&g;FAO. 2026. &l;em&g;Vanuatu&a;#58; poultry value chain&a;#160;&l;/em&g;&l;em&g;–&a;#160;&l;/em&g;&l;span style=\&q;font-size&a;#58;12.8px;\&q;&g;&l;em&g;Situation analysis&a;#58; special agricultural product.&l;/em&g;&a;#160;Bangkok.&l;/span&g;&l;br&g;&l;/p&g;&l;/div&g;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.date.available&q;:[{&q;uuid&q;:&q;b81b2b2d-39bc-4687-bd52-f0ae550435de&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-11-05T23:00:00Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.embargo&q;:[{&q;uuid&q;:&q;778cdbf8-977a-4223-9921-efd7361a8914&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;No&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.fasttrack&q;:[{&q;uuid&q;:&q;79d6c413-9adb-468f-a997-18b46d7309e9&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;No&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.identifier.jobnumber&q;:[{&q;uuid&q;:&q;263bdbc3-d2c8-4348-ad0e-a50de69bf49c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CE2324EN&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.identifier.pws&q;:[{&q;uuid&q;:&q;9d88d6a2-2dbc-4d8d-8bbc-f657d67e5181&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;340337&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.initiator&q;:[{&q;uuid&q;:&q;b0965a2f-6402-4955-a8d6-0f2ec8de87c4&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Kunwar, Karan (FAORAP)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.leadauthoringunit&q;:[{&q;uuid&q;:&q;e833bf3d-81bf-4661-a06c-da1096d59306&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;RAP - Regional Office for Asia and the Pacific&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.occnotes&q;:[{&q;uuid&q;:&q;aa308ffa-4992-4aca-9027-6db0fe5d5a0f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;&l;div class=\&q;ExternalClassB7A9F8F6D9444234A7B90EEAC558D9AE\&q;&g;&l;p&g;OCOP logo should be next to the FAO logo-- separated with a vertical line&l;br&g;&l;/p&g;&l;/div&g;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.otherentitiesinvolved&q;:[{&q;uuid&q;:&q;0e8abadc-c023-4145-a407-c4c61c99a9d0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;#25200;&q;,&q;place&q;:0,&q;aut