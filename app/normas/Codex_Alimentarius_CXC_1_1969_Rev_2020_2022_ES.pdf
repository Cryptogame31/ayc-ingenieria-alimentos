ditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/66cfd215-1ab1-4153-894d-a593da86356b&q;}},&q;_name&q;:&q;حالة الموارد السمكية وتربية الأحياء المائية في العالم 2026&q;,&q;id&q;:&q;66cfd215-1ab1-4153-894d-a593da86356b&q;,&q;uuid&q;:&q;66cfd215-1ab1-4153-894d-a593da86356b&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;b54b0ab0-fc31-49d4-a7b2-477f32ad0c79&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;منظمة الأغذية والزراعة;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;894f1b60-47ec-446d-8724-273b6f6da186&q;,&q;language&q;:null,&q;value&q;:&q;2026-09-03T10:40:28Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;8900989d-35bb-4377-800f-f77589ee4da7&q;,&q;language&q;:null,&q;value&q;:&q;2026-09-03T10:40:28Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;6dd661bf-99e2-44a5-b75d-65b9dc592b09&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;44e0adf3-94b7-40e0-a5d9-668312a86d60&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-09-03T10:36:39Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;a3a7a4b3-9f99-438c-afc1-f0a40d20687e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;يقدم تقرير حالة الموارد السمكية وتربية الأحياء المائية في العالم 2026 أحدث المعلومات والرؤى القائمة على الأدلة بشأن التحديات والفرص والحلول التي تشكّل حاضر القطاع ومستقبله.وتستعرض طبعة عام 2026 السبل التي تسلكها منظمة الأغذية والزراعة لترجمة رؤية \&q;التحوّل الأزرق\&q; إلى أثر، من خلال تنفيذ مشاريع ميدانية بالتعاون الوثيق مع الأعضاء والشركاء وأصحاب المصلحة الرئيسيين. ويسلّط التقرير الضوء على الجهود المبذولة لتعظيم مساهمة الأغذية المائية في الأمن الغذائي العالمي والحدّ من الفقر وتحقيق التنمية الاقتصادية، وتعزيز الدعوة في مجال السياسات، والنهوض بالبحوث العلمية والابتكارات، وتعزيز تنمية القدرات.ويقدم الجزء الأول استعراضًا عالميًا محدّثًا لإنتاج مصايد الأسماك وتربية الأحياء المائية والعمالة والاستخدام والتجارة، مستفيدًا من التحسينات الكبيرة في جمع البيانات وفي أدوات ومنهجيات التحليل والتقييم. ويستكشف الجزء الثاني الإجراءات التحويلية التي تضطلع بها المنظمة وأعضاؤها وأصحاب المصلحة الرئيسيون لتحفيز التغييرات اللازمة لدعم التوسّع في تربية الأحياء المائية وتكثيفها، والإدارة الفعالة لمصايد الأسماك العالمية، وتطوير سلاسل القيمة المائية. ويتناول الجزء الثالث التزامات المنظمة بتعزيز نظم الأغذية المائية على نحو شامل، مع التركيز على دور الأجهزة الإقليمية لمصايد الأسماك في ترجمة الالتزامات الدولية إلى تدابير إقليمية قابلة للتنفيذ؛ ويشدّد على أهمية البحوث والنماذج المناخية العالمية لإثراء سياسات وقرارات الإدارة التكيّفية لمصايد الأسماك. ويقدم أيضًا نظرة مستقبلية بشأن قطاع مصايد الأسماك وتربية الأحياء المائية حتى عام 2034، استنادًا إلى التوقعات.ويتوجه تقرير حالة الموارد السمكية وتربية الأحياء المائية في العالم إلى جمهور واسع ومتنامٍ من واضعي السياسات والمديرين والباحثين والجهات الفاعلة في القطاع الخاص والمجتمع المدني والمستهلكين.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;754f09e1-4460-4687-b57f-4c4aaa90d206&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;234 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;467db4d9-029f-4251-8afa-58a6a7110d63&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2663-8665&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;c807391f-c40c-493d-873e-8398eb648f96&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140834-6&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;7faec0c9-69fb-4e30-831e-9f15c118d52a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;1020-5519&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;586d89d6-28d8-4ab0-b431-bfcd240d4