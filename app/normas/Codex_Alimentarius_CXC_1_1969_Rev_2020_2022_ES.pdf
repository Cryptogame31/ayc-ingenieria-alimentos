8a-b9a9-452655425581&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO; UNEP; SCBD;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;3cfa412b-7f38-4d39-9e55-302fe3cd06c4&q;,&q;language&q;:null,&q;value&q;:&q;2026-10-28T16:20:34Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;b465ac5e-ff47-4de6-b31d-b3aee9685d1b&q;,&q;language&q;:null,&q;value&q;:&q;2026-10-28T16:20:34Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;aa8cd681-48a9-4dd4-8655-7a3c3bd45d3b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;6f7aeeda-e6a6-4bf8-8ef2-54eae494ee81&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-10-28T16:15:19Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;aba0ec15-b3e7-43e3-a519-7a8a6fc06f5d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;At the midpoint of the UN Decade on Ecosystem Restoration, this report provides the first comprehensive global assessment of progress towards restoring degraded ecosystems and achieving international restoration targets and commitments. Drawing on data from national reporting to the Rio Conventions and other multilateral environmental agreements, as well as global restoration monitoring initiatives and other sources, it evaluates the extent to which restoration efforts are contributing to the goals of the Kunming-Montreal Global Biodiversity Framework, with a particular focus on Target 2.Covering terrestrial, freshwater, marine and coastal ecosystems, the report examines restoration achievements to date, the scale and drivers of ecosystem degradation, documented restoration efforts, and the financing supporting implementation. It assesses whether current progress is sufficient to meet global ambitions and identifies key gaps in monitoring, implementation, policy and investment that continue to constrain action.Recognizing that restoration success depends on more than the number of hectares restored, the report also considers the social, institutional and governance dimensions that underpin lasting outcomes. Secure tenure rights, gender equality, meaningful participation, and the knowledge, rights and leadership of Indigenous Peoples are highlighted as essential components of effective and equitable restoration.Structured around two central questions, the report asks: How much progress has been made towards restoring degraded ecosystems, and what actions are needed to accelerate restoration at scale? It concludes by identifying practical solutions and strategic pathways to close existing gaps, strengthen implementation and turn restoration commitments into measurable results. As monitoring systems continue to evolve, future assessments will provide an increasingly robust picture of global progress towards ecosystem recovery by 2030 and beyond.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;09b8df3a-98a2-40e2-9dfb-35fa7eef0133&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;116 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;83706699-b123-4d61-9dfa-2dc63af61078&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-141087-5&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;98454d4b-42a7-4c72-9ef9-67b7823bec61&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/ce2114en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;547150c0-132f-4fae-bdb4-bea1da58cca3&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;0a256ac8-785f-47f7-bb56-fc87e1775ed3&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ; UNEP ; 