0-db4871243437/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/5aeb1187-6f9a-46e0-ab20-db4871243437&q;}},&q;_name&q;:&q;2026年世界渔业和水产养殖状况&q;,&q;id&q;:&q;5aeb1187-6f9a-46e0-ab20-db4871243437&q;,&q;uuid&q;:&q;5aeb1187-6f9a-46e0-ab20-db4871243437&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;1508a769-375a-44a2-84d8-7696d79cccd3&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;粮农组织;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;152050e6-4679-4a5e-b33b-536b076dd60b&q;,&q;language&q;:null,&q;value&q;:&q;2026-09-03T10:42:37Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;6b2b5347-4862-48c2-977b-b826e5d26498&q;,&q;language&q;:null,&q;value&q;:&q;2026-09-03T10:42:37Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;79e73841-44a8-431a-bd19-0909600eff91&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;370099c6-9db4-44a2-9629-de52e936d980&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-09-03T10:36:49Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;715db616-9231-49bb-877a-a971a453947c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;《2026年世界渔业和水产养殖状况》以实证为依据，提供最新信息，并提出深刻见解，剖析影响行业现状与未来的挑战、机遇及解决方案。2026年报告阐述粮农组织如何与成员、合作伙伴和关键利益相关方紧密协作，通过开展实地项目，将“蓝色转型”愿景转化为实效。本报告重点介绍各方为最大限度利用水产食品促进全球粮食安全、减贫和经济发展而付出的努力，包括加强政策宣导、推进科研创新、推进能力建设等方面。&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;17c13253-a139-4430-adba-250dce226e0d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;236 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;e3309930-c7ec-44fa-ad0e-219fef224d3f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2663-8622&q;,