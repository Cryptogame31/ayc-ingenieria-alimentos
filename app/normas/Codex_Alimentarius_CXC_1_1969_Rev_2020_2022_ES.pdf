},&q;_name&q;:&q;Agrifood systems emissions&q;,&q;id&q;:&q;a55b7c69-18f2-40d3-8deb-feb50189b3d4&q;,&q;uuid&q;:&q;a55b7c69-18f2-40d3-8deb-feb50189b3d4&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;71c30195-3be3-438c-b52d-11d3aa12e8d3&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;1dc79d28-fc3d-4794-b61c-35a04781bc59&q;,&q;language&q;:null,&q;value&q;:&q;2026-11-06T13:05:26Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;629a5415-15b6-4945-9ab2-f336e4973560&q;,&q;language&q;:null,&q;value&q;:&q;2026-11-06T13:05:26Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;f1890c21-5c40-4efa-a52b-01bd7f495c78&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;33498f63-9b01-43ce-8bbb-36e33096d5fa&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-11-06T13:01:36Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;50e6354a-41c7-46dd-8d92-fffbdcbff4b4&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Agrifood systems account for about one-third of total anthropogenic greenhouse gas emissions. They are generated within the farm gate, from crop and livestock production activities; by land-use change, caused by deforestation, biomass fires and peatland degradation processes often linked to land clearance for agriculture; and in pre and post agricultural production, comprising the supply chain including food manufacturing, retail, packaging, food transport, household consumption and food disposal. Statistics on the underlying activity data, emissions and indicators (shares of total economy, per capita emissions and emissions intensities) are disseminated in FAOSTAT at the country, regional and global levels, covering over 200 countries and territories, for the period 1961–2024, together with a comprehensive summary of emissions from the rest of the economy. Data are provided by single component gases – carbon dioxide, methane, nitrous oxide (N2O) and fluorinated gases – as well as in carbon dioxide equivalents. This analysis focuses on the period 2001–2024. Global agrifood systems emissions reached 18.5 billion tonnes of carbon dioxide equivalent in 2024, up 21 percent since 2001. Their share in total emissions fell from 45 percent in 2001 to 35 percent in 2024.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;4d1b602c-484a-42d8-bb0f-d028049b2f84&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;12 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;220326ac-89d3-434d-8756-984f383fdea8&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2709-0078&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;dd3a11e8-45a8-410b-b501-fb84d425d765&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2709-006X&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;efef7ae4-b4cb-42ad-8d8f-0c38c7a7f428&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/ce2400en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;125cc0f0-6e36-41b5-a54a-4fc34ec2e547&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;cfa65c69-56c1-4adb-ac7d-1fcaf070967a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.ispartofseries&q;:[{&q;uuid&q;:&q;10b9ea08-759a-411d-b9e2-f2877bdfa936&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAOSTAT Analytical Briefs&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rela