s&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/a7ab6a52-64ea-4e9e-a04f-a4b97e92af71/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/a7ab6a52-64ea-4e9e-a04f-a4b97e92af71&q;}},&q;_name&q;:&q;Status of the world&s;s soil resources 2026&q;,&q;id&q;:&q;a7ab6a52-64ea-4e9e-a04f-a4b97e92af71&q;,&q;uuid&q;:&q;a7ab6a52-64ea-4e9e-a04f-a4b97e92af71&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;498ef6bd-aa8b-419f-a142-3d1b66637dcd&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO; ITPS;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.coverage.spatial&q;:[{&q;uuid&q;:&q;adced81d-5416-4a0d-a3a2-0e39be2f6fac&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;World&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;cb74404f-0f8d-4f35-89b6-6b5b5fcd39a7&q;,&q;language&q;:null,&q;value&q;:&q;2026-10-22T12:06:39Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;67494985-df55-4a39-b71c-b6bacb8d0e80&q;,&q;language&q;:null,&q;value&q;:&q;2026-10-22T12:06:39Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;b4aa30f0-4b39-4c02-ae43-5cabbd7e29ea&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;1cf9c1bd-6aec-4cbf-9dec-3e7bf5143bc2&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-10-22T12:03:12Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;0074b9d9-b174-44e5-b22d-833a11f8b5d4&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Soils are a unique resource providing a wide range of services for ecosystem functioning and human well-being. Despite more than a hundred years of soil science history, we still do not fully understand the dynamics and status of the world&s;s soils, and efforts to protect, conserve and sustainably manage this valuable resource have always been limited by knowledge.In an effort to improve understanding of the status of this resource and to identify threats and activities leading to its degradation, the Intergovernmental Technical Panel of Soils (ITPS) supported by the Food and Agriculture Organization of the United Nations and its Global Soil Partnership (GSP) embarked in 2014 on the preparation of a global assessment to enable countries to better understand what actions should be taken to promote sustainable soil management. The Report on the Status of the World Soil Resources (SWSR) 2015 is a reference work and a milestone among the documents assessing global soil quality and soil health change. Its publication was possible thanks to the work of the first ITPS. Ten years later, in 2026, the ITPS and the GSP secretariat publishes a second edition of the SWSR where all the scientific documents and publications reporting on the evolution of the status of soils and of the different soil threats will be taken into account, together with regional assessments, to know what has been the trend of the status of soils in these 10 years and where are we facing to.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;75bfffd0-62c6-4b08-b520-49bb3864c9cd&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;850 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;cd4ea29e-77a3-41e3-aef2-b8adecd0a467&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140884-1&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;9916c020-6abf-46a0-86d4-c34db094b6d9&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/ce0792en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;08d0e498-8539-41d1-929d-67705a3472fe&q;,&q;language&q;:&q;&q;,&q;va