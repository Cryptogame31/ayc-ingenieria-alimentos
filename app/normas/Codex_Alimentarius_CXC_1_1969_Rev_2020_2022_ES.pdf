2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;e028abb5-ea1b-4958-b2b1-ad0844f112c9&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-06-26T08:47:34Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;78ff40f8-bf60-4fe1-8d46-2921391bf0ef&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The Agricultural Outlook 2026–2035 is a collaborative effort of the Organisation for Economic Co-operation and Development (OECD) and the Food and Agriculture Organization of the United Nations (FAO). It brings together the commodity, policy, and country expertise of both organisations, as well as input from collaborating member countries, to provide an annual assessment of the prospects for the coming decade of national, regional, and global agricultural commodity markets.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;91d3c34b-6a34-4838-be95-fa7e847daecc&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;166 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;fe71b8d1-b5c8-4212-adf1-5c5bccdefec7&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;1999-1142&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;74af5e6c-306c-4a1a-933e-0c78c49eda21&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140769-1&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;ac9db9ee-3560-42c8-87c2-fc46b6d0deb0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;1563-0447&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;ed9dbd68-52c4-4850-8c0b-189798547445&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/ce0211en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;13386d1c-3e3e-4ee9-b00a-9f6179dca8c1&