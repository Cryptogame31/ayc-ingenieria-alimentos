.issued&q;:[{&q;uuid&q;:&q;57563f29-89c1-4ece-a6be-b6bd557b154d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;ec7d9c0a-4c4d-4551-8600-05620f443129&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-10-29T09:48:29Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;d675d8d6-c7b3-4f80-9a2b-4721afa10acb&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Across farms, rangelands and waters around the world, women sustain food systems through their labour, knowledge and resilience. From growing crops and herding livestock to fishing, processing and trading food, their contributions are essential yet too often overlooked. Published during the International Year of Woman Farmer and the International Year of Rangelands and Pastoralists, this cookbook celebrates the women behind the recipes, highlighting the skills, traditions and innovations that nourish communities and support more sustainable agrifood systems.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;6793e2cd-7e78-4518-b355-a3b1c926b7ff&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;152 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;b1d23135-828e-4cf3-8762-141d515b313e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140956-5&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;1aa258b0-af68-4e07-aebc-fbbb59404f7f&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/ce1223en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;27888990-bfbe-4f2d-9565-6bc292e300ce&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;7d833a1e-081e-4579-97b3-6463daf35d9e&q;,&q;l