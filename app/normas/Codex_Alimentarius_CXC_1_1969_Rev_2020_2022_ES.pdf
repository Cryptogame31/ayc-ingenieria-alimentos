lection&q;},&q;relationships&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/ba69f283-c703-456e-8b1c-c88c9ef6bd10/relationships&q;},&q;version&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/ba69f283-c703-456e-8b1c-c88c9ef6bd10/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/ba69f283-c703-456e-8b1c-c88c9ef6bd10/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/ba69f283-c703-456e-8b1c-c88c9ef6bd10/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/ba69f283-c703-456e-8b1c-c88c9ef6bd10/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/ba69f283-c703-456e-8b1c-c88c9ef6bd10&q;}},&q;_name&q;:&q;Tchad: Bulletin DIEM-Suivi sur l&s;assistance agricole d’urgence, septembre 2026 (cycle 10)&q;,&q;id&q;:&q;ba69f283-c703-456e-8b1c-c88c9ef6bd10&q;,&q;uuid&q;:&q;ba69f283-c703-456e-8b1c-c88c9ef6bd10&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;2b190e3b-1913-4373-a93e-fa78fbc85767&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.coverage.spatial&q;:[{&q;uuid&q;:&q;0291e79d-08fd-480a-a07c-719c8b4c25ff&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Chad&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;d928cf7e-2e7d-44b9-9cd9-eaa7f92240a7&q;,&q;language&q;:null,&q;value&q;:&q;2026-11-06T15:10:26Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;83fbc3a9-8923-4bf8-a89b-b7a34ac4fa6c&q;,&q;language&q;:null,&q;value&q;:&q;2026-11-06T15:10:26Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;e73f4fa6-519b-4253-bd1a-76008e33829f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;d8006848-a2ef-4d23-bd2f-992263f5c00e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-11-06T15:06:41Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;928c86ef-0205-498b-9872-5d6139a8e798&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Ce bulletin sur l’aide agricole d’urgence présente les résultats de l’enquête Données en situations d’urgence – Suivi (DIEM-Suivi) réalisée en juillet et août 2026 au Tchad. L’analyse a permis d’estimer à plus de 67 000 le nombre de ménages agricoles de résidents ayant besoin d’une assistance d’urgence en matière de sécurité alimentaire dans les six provinces couvertes par l’enquête. Ce document offre aux acteurs humanitaires une analyse détaillée des besoins des ménages agricoles, afin de mieux cibler les interventions destinées à soutenir leurs moyens d’existence, à renforcer leur résilience face aux chocs futurs et à préserver la sécurité alimentaire des populations rurales.L’Organisation des Nations Unies pour l’alimentation et l’agriculture (FAO) a mis en place DIEM-Suivi en juin 2020. Les données sont collectées plusieurs fois par an, dans les pays en situation d’insécurité alimentaire, par les enquêteurs DIEM lors d’entretiens téléphoniques assistés par ordinateur et d’enquêtes en face à face. Ces données couvrent les chocs, les moyens d’existence agricoles, la sécurité alimentaire et les besoins des ménages. Elles sont régulièrement mises à jour et facilement accessibles sur la plateforme DIEM. Les produits DIEM comprennent des tableaux de bord, des cartes, des bulletins et des données agrégées, qui permettent aux partenaires et aux parties prenantes de mettre en œuvre des mesures d’atténuation et de cibler les ménages vulnérables.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;d0d2688b-2f97-461e-9200-53c2e472b855&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;12 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;72b395be-8f29-4135-930c-2ef8d7c2e1fd&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/ce2422fr&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;3fb3f5fc-9871-4920-bd05-c6e920a2c24e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;French&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;fe82c2d4-37fd-4f81-b2a1-e75d492fed1b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;803ed444-7d93-4fdd-bdc0-a278a1b7897f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;6d479eab-9d2c-4623-971a-f81d2292838b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CC BY 4.0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;922de888-a5e5-4fa3-be9f-33902af78e99&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Tchad: Bulletin DIEM-Suivi sur l&s;assistance agricole d’urgence, septembre 2026 (cycle 10)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title.englishtranslation&q;:[{&q;uuid&q;:&q;67c2ef90-0c99-489c-8a8a-32d2adf39167&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Chad: DIEM-Monitoring emergency agriculture support brief, September 2026 (round 10)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.type&q;:[{&q;uuid&q;:&q;c3f2c881-3d1d-4b80-95a9-9d34a3bcf582&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Booklet&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.altmetricbadge&q;:[{&q;uuid&q;:&q;cc9937ac-0a02-4c10-9510-ebe9d017c4f5&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;No&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.cardvisibilitytype&q;:[{&q;uuid&q;:&q;3e906efa-d61d-478f-970f-a5a