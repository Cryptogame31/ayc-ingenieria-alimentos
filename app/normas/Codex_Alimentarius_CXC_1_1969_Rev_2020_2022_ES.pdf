r/api/core/items/54f2a585-b703-4663-8537-5bfd287db4da/owningCollection&q;},&q;relationships&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/54f2a585-b703-4663-8537-5bfd287db4da/relationships&q;},&q;version&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/54f2a585-b703-4663-8537-5bfd287db4da/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/54f2a585-b703-4663-8537-5bfd287db4da/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/54f2a585-b703-4663-8537-5bfd287db4da/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/54f2a585-b703-4663-8537-5bfd287db4da/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/54f2a585-b703-4663-8537-5bfd287db4da&q;}},&q;_name&q;:&q;FAO and the SDGs&q;,&q;id&q;:&q;54f2a585-b703-4663-8537-5bfd287db4da&q;,&q;uuid&q;:&q;54f2a585-b703-4663-8537-5bfd287db4da&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;3897916e-6622-4a01-96cf-1acde5acde6d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;4882240d-378b-47ba-b60c-986da95d08de&q;,&q;language&q;:null,&q;value&q;:&q;2026-05-27T16:11:51Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;b76c28a8-0340-4c63-a324-e84ddccc30ec&q;,&q;language&q;:null,&q;value&q;:&q;2026-05-27T16:11:51Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;e9838ec8-8955-44f2-bb4e-0c3fcacd8bf4&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;fc9c8394-a60b-4410-910c-2c343c09ebbd&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-05-27T16:02:49Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;d1a109e7-735d-4b00-bf8d-939c8661829d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO and the SDGs – Accelerating transformation through the four betters provides a comprehensive overview of how transforming agrifood systems can drive progress across the entire 2030 Agenda for Sustainable Development. Drawing on FAO’s mandate and the Strategic Framework 2022–2031, the publication highlights the central role that sustainable, inclusive and resilient agrifood systems play in addressing global challenges such as hunger, poverty, inequality, climate change and environmental degradation.The publication brings together 17 concise briefs, one for each Sustainable Development Goal (SDG). Each brief outlines the relevance of agrifood systems to the Goal, presents key global trends and challenges, and highlights FAO’s areas of action and support to Members. It also identifies priority actions, innovations and partnerships needed to accelerate progress, offering practical entry points for governments and partners working to advance sustainable development.Together, the briefs show how progress on the SDGs is deeply interconnected with agrifood systems transformation. Framed through FAO’s four betters – better production, better nutrition, better environment and a better life – the publication presents an integrated roadmap for accelerating action across all 17 SDGs, while ensuring that agrifood systems contribute to a more sustainable, resilient and inclusive future.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;53b70c74-34f4-4602-8d3b-65254f6c4b51&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;162 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;fb16ad3b-7d5b-4347-82ec-b9c3370b5d26&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140625-0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;082910f1-18f7-4af7-addd-52341b9c2912&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd8857en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;0a5e984c-f020-4d0c-a500-d2900cfb0043&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;13fa5962-e1b7-4e09-b648-ec836919f536&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;de1b98e2-7cc3-4e91-aff2-95c76de593c4&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;731ebe06-be0e-4374-8049-37f87dd18c3a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CC BY 4.0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;3f51ca76-90b2-40a8-b9c2-b66d637324f7&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO and the SDGs&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title.subtitle&q;:[{&q;uuid&q;:&q;7e0106db-9721-4950-a4fd-0054f2a96b0b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Accelerating transformation through the four betters&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.type&q;:[{&q;uuid&q;:&q;0fc685da-9a52-4d3f-9d79-26a2250aac13&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Book (stand-alone)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.altmetricbadge&q;:[{&q;uuid&q;:&q;18b6e4c1-2b7b-4f94-8a59-5bf6b77bf4e7&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Yes&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.cardvisibilitytype&q;:[{&q;uuid&q;:&q;06421055-e2b0-411d-ae17-1ca271eef708&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Public&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.citation&q;:[{&q;uuid&q;:&q;e7511c24-4314-445