:&q;2026-11-06T13:20:25Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;970b883c-f880-442f-bb37-65a7513faf2f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;b63f76ec-24c3-45d3-8284-0a56b34db557&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-11-06T13:16:15Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;4614dfbe-bc60-4a0c-addc-15977247879e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;La necesidad de mejorar la gestión de los residuos orgánicos en el Mercado Mayorista Lo Valledor, en Chile, responde a los desafíos operativos, ambientales y económicos asociados al manejo de los grandes volúmenes de frutas y hortalizas que quedan sin vender cada día. Como principal mercado mayorista de frutas y hortalizas del país, Lo Valledor ha desarrollado un sistema integral de valorización que prioriza la redistribución de alimentos para el consumo humano, seguida del aprovechamiento de los excedentes vegetales para la alimentación animal y, finalmente, del compostaje. En 2025, este modelo permitió recuperar más de un millón de kilogramos de alimentos destinados a organizaciones sociales, destinar aproximadamente 5.100 toneladas de excedentes vegetales a familias dedicadas a la ganadería y compostar 17.000 toneladas de residuos orgánicos. Además, la iniciativa demuestra que la sostenibilidad, el impacto social y la rentabilidad pueden avanzar de manera conjunta al reducir los costos de disposición final, apoyar a las comunidades vulnerables, fortalecer los medios de vida rurales y reincorporar la materia orgánica a los ciclos productivos. Actualmente, se valoriza alrededor del 65 % de los residuos del mercado, lo que contribuye a su objetivo de no enviar residuos orgánicos a rellenos sanitarios para 2030.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;ea80617e-0847-4920-89bb-2110aa3566c2&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;3 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;a8f5c5d4-28b9-4a7e-bacb-0bcb08ff26ba&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/ce1856es&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;1f613715-3390-4cff-8cbc-52add6e37c10&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Spanish&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;bd233d43-56a8-4f32-b7ea-2d0ffba64f97&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;dfa948c7-9601-4e51-b590-b57ac8a12af4&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;1f22e894-3151-4baa-8c5c-15015f918879&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CC BY 4.0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;aa44901b-1170-4328-a02e-cd9debae3aff&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;De un problema operacional a una estrategia de sostenibilidad&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title.englishtranslation&q;:[{&q;uuid&q;:&q;77146e4e-26b9-4bdf-a60a-89ce807d8d0e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;From an operational problem to a sustainability strategy&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title.subtitle&q;:[{&q;uuid&q;:&q;c9da5c32-4e72-4148-8500-17e6b547fb95&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Voces y visiones del mercado&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title.subtitleenglishtranslation&q;:[{&q;uuid&q;:&q;e1bdd030-1b9d-43ce-8f8d-18f76d296632&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Voices and visions from the markets&q;,&q;place&q;: