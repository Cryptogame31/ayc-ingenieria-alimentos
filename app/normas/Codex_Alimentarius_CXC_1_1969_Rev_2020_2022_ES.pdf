}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;e6305ed1-769b-4859-97da-271955f497cc&q;,&q;language&q;:null,&q;value&q;:&q;2026-11-06T13:15:26Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;f90b9dbe-874a-49e6-a8d4-130bf28f87d8&q;,&q;language&q;:null,&q;value&q;:&q;2026-11-06T13:15:26Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;6dae1d8e-78ee-4409-827d-638f3c3b6eaa&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;42dc52dd-118c-4155-955e-65adbf51189f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-11-06T13:14:22Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;c519e1e4-cd9a-4527-a2c1-c87dae4d9aff&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;This document provides practical guidance on strengthening the contribution of fisheries and aquaculture to the formulation and implementation of National Adaptation Plans (NAPs). It outlines approaches for integrating fisheries and aquaculture into a multi-sectoral NAP (section 2), and for developing a sectoral NAP (section 3), as appropriate to national circumstances. It aims to support policymakers, government personnel and other stakeholders in the aquatic food sector involved in NAP formulation and implementation processes.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;66c641bd-a9df-4adc-9ba2-7ba482871273&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;28 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;17712f66-d44f-4ba5-b7b0-e612834d09e3&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/ce2230en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;6e74c219-054b-4695-aa2c-6c83ea5a404a&q;,&q;l