:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/e3967976-e462-4564-9f70-90ff48c14fa8/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/e3967976-e462-4564-9f70-90ff48c14fa8/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/e3967976-e462-4564-9f70-90ff48c14fa8/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/e3967976-e462-4564-9f70-90ff48c14fa8&q;}},&q;_name&q;:&q;L’État de la sécurité alimentaire et de la nutrition dans le monde 2026&q;,&q;id&q;:&q;e3967976-e462-4564-9f70-90ff48c14fa8&q;,&q;uuid&q;:&q;e3967976-e462-4564-9f70-90ff48c14fa8&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;200cba80-2f74-444c-9696-06e45f99ba8a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO; FIDA; OMS; PMA; UNICEF;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;7ced7b4d-03a4-4c2d-9b07-a4fcc718ec81&q;,&q;language&q;:null,&q;value&q;:&q;2026-10-21T07:45:30Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;f2c8916d-b649-492c-b04a-2029575ce2c0&q;,&q;language&q;:null,&q;value&q;:&q;2026-10-21T07:45:30Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;15189213-8487-4162-a666-d2d1c870d793&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;5eaa08a0-bd2d-485e-bced-ae8e4f5a25d2&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-10-21T07:39:28Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;9cd9891f-7a1b-4eb5-85f8-cc9421b03417&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Malgré une amélioration progressive et continue ces dernières années, les niveaux mondiaux de la faim et de l’insécurité alimentaire dépassent encore largement les cibles définies dans le Programme de développement durable à l’horizon 2030. D’après les estimations, 645 millions de personnes souffraient de la faim en 2025. Au-delà d’un apport énergétique suffisant, les populations doivent disposer d’un accès économique à des aliments nutritifs, diversifiés et sans danger pour la santé. Cependant, l’accès à une alimentation saine reste hors de portée pour quelque 2,7 milliards de personnes dans le monde, et la situation se détériore tout particulièrement en Afrique. Les auteurs de l’édition 2026 du rapport sur L’État de la sécurité alimentaire et de la nutrition dans le monde analysent ce problème pressant en examinant les facteurs structurels qui expliquent la persistance du coût élevé d’une alimentation saine. Le présent rapport révèle que les prix élevés des aliments riches en nutriments (en particulier les aliments d’origine animale, les fruits et les légumes) représentent près de 70 pour cent du coût d’une alimentation saine. À partir des données et des outils d’analyse existants, il montre que les disparités géographiques, les déficits de productivité agricole et les facteurs d’inefficacité dans les chaînes de valeur (notamment les pertes et le gaspillage alimentaires) entravent de manière critique l’accès à une alimentation saine. Pour parvenir à éliminer durablement la faim, les décideurs publics doivent mettre en place des interventions ciblées et multisectorielles qui vont de la réorientation des subventions agricoles vers l’horticulture à l’investissement dans des chaînes du froid et des réseaux de transport fiables. Le présent rapport expose aux gouvernements et aux parties prenantes une stratégie globale visant à réduire structurellement les coûts de l’alimentation et à préserver le capital humain, tout en éliminant les coûts cachés des systèmes agroalimentaires.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;e5caac03-1403-4169-a21d-9a29bfe0e774&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;279 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;971e9e66-c0d5-47ec-8413-055fb26f7f3c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2663-8630&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;883cc127-329d-4477-ad95-9261fbccd418&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-141003-5&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;9b276b1d-e473-45c9-a92d-ed1880b6ef38&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2522-7416&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;8682ab6a-76b6-433e-bd79-fb9b869c9858&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd8306fr&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;6b30af59-5ca7-43c8-916f-f379843893db&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;French&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;8fef58a7-d4a1-4c39-866e-dee96d6a7e92&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ; FIDA ; OMS ; PAM ; UNICEF ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.ispartofseries&q;:[{&q;uuid&q;:&q;e028a8a7-dacd-4c73-826b-4fa77ab88fbe&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;L&s;état de la securité alimentaire et de la nutrition dans le monde&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.number&q;:[{&q;uuid&q;:&q;297e8fd6-5533-4926-8da8-1f151ae6c6e5&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;65e38e42-17dc-4381-bb78-a0aebdd290f9&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;bdecef