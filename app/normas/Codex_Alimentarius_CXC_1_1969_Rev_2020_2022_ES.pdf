&q;:{&q;bundles&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/10293134-009e-416b-876b-84158530c89d/bundles&q;},&q;mappedCollections&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/10293134-009e-416b-876b-84158530c89d/mappedCollections&q;},&q;owningCollection&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/10293134-009e-416b-876b-84158530c89d/owningCollection&q;},&q;relationships&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/10293134-009e-416b-876b-84158530c89d/relationships&q;},&q;version&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/10293134-009e-416b-876b-84158530c89d/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/10293134-009e-416b-876b-84158530c89d/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/10293134-009e-416b-876b-84158530c89d/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/10293134-009e-416b-876b-84158530c89d/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/10293134-009e-416b-876b-84158530c89d&q;}},&q;_name&q;:&q;The status of land tenure and governance&q;,&q;id&q;:&q;10293134-009e-416b-876b-84158530c89d&q;,&q;uuid&q;:&q;10293134-009e-416b-876b-84158530c89d&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;a0cdd3ad-a76a-4e63-af2f-3dca8c4110e9&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO; ILC; CIRAD;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;653da452-5a1a-4fe6-9425-7d9234a53af2&q;,&q;language&q;:null,&q;value&q;:&q;2026-02-25T08:30:17Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;fa51c1a2-2df0-4ea6-abd7-e849930d39bf&q;,&q;language&q;:null,&q;value&q;:&q;2026-02-25T08:30:17Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;af464556-2894-489c-970e-d4bf538b3eef&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;4d1b7dd5-e297-4138-a25a-914e3acf9529&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-02-25T08:27:13Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;2a156692-2bcb-43a0-8784-2c3e18484c5f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;This report generates, presents and assesses innovative data, and extracts insights regarding land tenure systems and governance frameworks, with special focus on women&s;s land rights and the importance of customary tenure for mitigating climate change and ensuring the protection of biodiversity. Bringing together tenure- and sex- disaggregated data and analyses on land tenure and governance from a variety of sources (governments, civil society and academia) at different levels (from local to global), it builds an evidence base for action towards the achievement of numerous Sustainable Development Goals, the uptake of the Voluntary Guidelines on the Responsible Governance of Tenure of Land, Fisheries and Forests in the Context of National Food Security (VGGT), and other international frameworks (such as the Principles for Responsible Investment in Agriculture and Food Systems [CFS-RAI] and the Rio Conventions).The report also aims to provide policymakers, intergovernmental organizations, civil society, the private sector, and academia with a clear reference point on data and analyses on land tenure and governance. Moreover, it endeavours to mainstream and highlight the importance of land tenure for inclusive and sustainable development.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;3cfdcbf4-6d3e-48c4-939f-70270dfa376f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;264 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;1c2dca78-32e5-4416-81e8-af511f0af389&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140491-1&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;6230da5e-8863-4da5-bc0a-395c05985ff2&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd8473en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;32b7a429-d54c-4ab0-909b-05d131206fd6&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;c9609e34-fd0b-4e6e-9641-4fa8b7da5454&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ; ILC ; CIRAD ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;aaad1839-fdac-43e8-8b4a-b8046c7663f8&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Shared&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;35c1189b-ee1c-40ba-91ab-67e4a0a528cc&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CC BY 4.0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;f3fc3e2c-e8f4-4374-9502-3f4159f2867d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The status of land tenure and governance&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.type&q;:[{&q;uuid&q;:&q;89c3d6cf-a9b2-499a-994f-69f16e002c68&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Book (stand-alone)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.altmetricbadge&q;:[{&q;uuid&q;:&q;4491f646-7faa-41a7-a93d-a7200cf84b68&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Yes&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.cardvisibilitytype&q;:[{&q;uuid&q;:&q;80107e43-01ae-4167-8654-fe3209239ccb&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Public&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.citation&q;:[{&q;uuid&q;:&q;232b681a-6669-401d-9372-2441a6ddf1b0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;&l;div class=\&q;ExternalClassD1436F7C82F24518AC03CF0D508F66C1\&q;&g;&l;p&g;&l;span style=\&q;color&a;#58;#000000;font-size&a;#58;10.5pt;font-family&a;#58;&a;quot;segoe ui&a;quot;, sans-serif;\&q;&g;FAO, ILC and CIRAD. 2026.&a;#160;&l;em&g;The status of land tenure and governance&l;/em&g;. Rome and Paris.&l;/span&g;&l;br&g;&l;/p&g;&l;/div&g;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.contentcategory&q;:[{&q;uuid&q;:&q;04da2e39-b697-42a0-9275-4d74e29025a6&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Technical&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.date.available&q;:[{&q;uuid&q;:&q;1f4e89ca-c990-4ed6-9980-65e8460ba3fc&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-02-24T23:00:00Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.embargo&q;:[{&q;uuid&q;:&q;44fa15ba-2c9e-432b-b44b-0e11b6fd4750&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Terminated&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.embargodate&q;:[{&q;uuid&q;:&q;4ac0b125-4b2b-4702-a865-9cd1cf201fc8&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-02-25T09:00:00Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.fasttrack&q;:[{&q;uuid&q;:&q;cb686ad5-1672-47e8-abb9-24253543f52e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;No&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.identifier.doi&q;:[{&q;uuid&q;:&q;1bc8b401-6008-49af-a5eb-ae03149adb7b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;https://doi.org/10.4060/cd8473en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.identifier.googlebookurl&q;:[{&q;uuid&q;:&q;be9c2184-109d-4cf3-a131-aee1bfe20771&q;,&q;language&q;:null,&q;value&q;:&q;https://shop.un.org/node/27938&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.identifier.jobnumber&q;:[{&q;uuid&q;:&q;7f34cefa-5c6a-49e8-b119-8859a19da3bf&q;,&q;language&q;