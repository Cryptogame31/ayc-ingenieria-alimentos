&q;uuid&q;:&q;9de074cf-cdc0-4746-9ea6-e7c3629415e5&q;,&q;language&q;:null,&q;value&q;:&q;2026-06-25T07:50:17Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;e3fd75cc-d3e4-4c4f-b75b-78db0a6f0873&q;,&q;language&q;:null,&q;value&q;:&q;2026-06-25T07:50:17Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;11488a09-2709-4577-a245-57500f72afe6&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;13d1d724-28d8-495a-a998-a2874f79d8b6&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-06-25T07:46:12Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;e4313f32-c8fb-4e59-a234-9ecfd6286632&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;A joint FAO and Bauhaus technical report examining how greater adoption of engineered wood products (EWPs) in construction could contribute to climate change mitigation. Using the FOROM global forest model, the report runs multiple scenarios out to 2070, testing different urbanization and wood-use assumptions, to project future EWP demand, estimate carbon storage and emissions substitution benefits, and benchmark results against national climate commitments (nationally determined contributions). Even under conservative assumptions, the findings point to EWPs as a credible and scalable climate strategy within a sustainably managed forest-based bioeconomy.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;2ebe967e-21f5-404b-95fa-809efac710d9&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;142 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;a49c600b-d7e8-45b2-9b72-77806e1f6314&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140786-8&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q