ps://openknowledge.fao.org/server/api/core/items/572a3305-91ea-4264-8ef1-b63660ada9d3/relationships&q;},&q;version&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/572a3305-91ea-4264-8ef1-b63660ada9d3/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/572a3305-91ea-4264-8ef1-b63660ada9d3/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/572a3305-91ea-4264-8ef1-b63660ada9d3/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/572a3305-91ea-4264-8ef1-b63660ada9d3/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/572a3305-91ea-4264-8ef1-b63660ada9d3&q;}},&q;_name&q;:&q;2026 Global Report on Food Crises&q;,&q;id&q;:&q;572a3305-91ea-4264-8ef1-b63660ada9d3&q;,&q;uuid&q;:&q;572a3305-91ea-4264-8ef1-b63660ada9d3&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;5de57f54-1434-407f-ac3a-9e78d4796bf9&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO; WFP; Global Network Against Food Crises (GNAFC);&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;792eade9-cdca-4537-b028-8c20727fea2f&q;,&q;language&q;:null,&q;value&q;:&q;2026-04-24T07:35:23Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;8a1edff9-9122-4426-9ab5-43f680aa0949&q;,&q;language&q;:null,&q;value&q;:&q;2026-04-24T07:35:23Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;eeec510f-b789-4507-a5aa-ee34eb0b4b68&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;34ac6bc2-358d-440e-8c84-1b3b2d4ba77e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-04-24T07:30:41Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;703c68c6-330e-412f-8baf-8936c5703b3b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The Global Report on Food Crises (GRFC) 2026 reveals that acute food insecurity and malnutrition remain at alarmingly high and deeply entrenched levels, with crises increasingly concentrated in a core group of countries. In its tenth edition, the report shows that acute hunger has doubled over the past decade, with two famines declared last year for the first time in its history.As a flagship publication of the Global Network Against Food Crises (GNAFC), the GRFC serves as the key reference for understanding acute food insecurity at global, regional and country levels. Produced through a collaborative effort among 18 partners, it provides a consensus-based assessment of acute food insecurity and malnutrition in countries affected by food crises, with the aim of informing and guiding both humanitarian and development responses.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;71ae3641-ca08-4b6b-ab7e-0770ad25e990&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;80 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;07a71525-6f21-4c71-baff-6b6740edadf0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140659-5&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;0eaefd82-b1e2-4ad3-a98b-f9fb6e4316b7&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd9424en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;19c7c2df-cc48-4a91-977b-aaaf85b60d91&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;dc57adba-fc93-46f2-a404-b6bd9aeccc36&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ; WFP ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;: